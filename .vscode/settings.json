{
  "git.autofetch": false,
  "git.autorefresh": false,
  "git.detectSubmodules": false,
  "git.autoStash": false,
  "git.showProgress": false,
  "git.untrackedChanges": "separate",
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/.vercel/**": true,
    "**/node_modules/**": true,
    "**/.user_uploaded/**": true
  },
  "git.openRepositoryInParentFolders": "never"
}
